from PIL import Image, ImageDraw, ImageFont

# Create image
img = Image.new('RGB', (1080, 1920), color=(255, 100, 100))
draw = ImageDraw.Draw(img)

# Add text
text = "Scene 2: Intense futuristic lab with glowing AI core"
draw.text((50, 900), text, fill=(255, 255, 255))

# Save
img.save('output/visuals/scene_2.png')
print("✅ Scene 2 created")
